# The sources Haven's MLS stack is allowed to resolve from. Sourced by
# check_mdk_supply_chain.sh and check_lockfile_universe.sh, which hold
# haven-core, haven/rust_builder and tooling/soak to exactly these values.
#
# Version alone cannot tell two sources apart: a git fork of openmls and the
# crates.io release both call themselves 0.8.1, and a patched libsqlite3-sys can
# share its version with the registry one. So every pin here is a full lockfile
# `source` string, compared byte for byte.
#
# Bumping MDK: change these values and every Cargo.toml rev in ONE commit, then
# run both guards. A value here that disagrees with the manifests fails CI.

# The MDK release rev (v0.10.4). Every crate resolved from the MDK repository
# must carry exactly this source.
HAVEN_MDK_REV=fcc85edd8dbd07c8293c899ee52230f72c54c897
HAVEN_MDK_SOURCE="git+https://github.com/marmot-protocol/mdk?rev=${HAVEN_MDK_REV}#${HAVEN_MDK_REV}"

# Where the openmls crates MDK builds on come from: MDK v0.10.4 builds on the
# erskingardner fork (extensions-draft), not a crates.io release
# (docs/MDK_UPSTREAM_TRACKER.md T-OPENMLS-FORK).
HAVEN_OPENMLS_SOURCE="git+https://github.com/erskingardner/openmls.git?rev=59e7d3b27a7e95237879dd5478de1fd90eff7ada#59e7d3b27a7e95237879dd5478de1fd90eff7ada"

# The one SQLCipher build: libsqlite3-sys is a `links = "sqlite3"` crate. MDK
# v0.10.4 patches it to a rusqlite git rev, and a `[patch]` binds only the root
# that declares it, so every Haven root repeats it
# (docs/MDK_UPSTREAM_TRACKER.md T-LIBSQLITE-PATCH).
HAVEN_LIBSQLITE3_SOURCE="git+https://github.com/rusqlite/rusqlite.git?rev=5ae7fdf83085c595fd54f977b3a56ccacabaf16b#5ae7fdf83085c595fd54f977b3a56ccacabaf16b"
HAVEN_LIBSQLITE3_VERSION=0.38.1
