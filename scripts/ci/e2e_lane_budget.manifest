# What every wait on an E2E lane's path costs. Read by
# scripts/ci/check_e2e_lane_budget.sh, which finds the waits in the code and
# refuses a lane unless each is claimed here, and the lane's deadline covers
# the sum plus the one unbounded-work allowance the check itself declares. The
# rules a claim must meet are stated once, in that script's header.
#
# Bounds are never restated here: a charge names the script's own constants
# (a bare integer only for a literal wait or tick), and the check evaluates
# them from their definitions and the env the workflow passes, so changing a
# constant changes the lane's sum.
#
#   unit <path>        a script, analysed from its top level
#   lib  <path>        a sourced library; paths start at the called function
#
#   <label> <pattern> charge <expr> [times <expr>] [once <why>]
#   <label> <pattern> poll [times <expr>] [once <why>]
#   <label> <pattern> within <label> <why>
#   <label> <pattern> concurrent | allowance
#   <label> <pattern> excluded <why>
#
#   reaper <workflow>::<job> <why>
#   unbudgeted <workflow>::<job> <why>
#
# <pattern> is a bash glob over a wait's path, as
# `check_e2e_lane_budget.sh --sites <script>` prints it; the first matching
# claim wins. <expr> is constants, integers, `@` (the called script's or
# function's own budget), + - * ( ). Comments are full lines only.

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

unit tooling/e2e/ci/start-strfry.sh
# The pull runs only when the image is not digest-pinned AND local. Every lane
# starts strfry in an earlier step of its job, which pulls the pinned image, so
# the restarts inside a deadline skip it. A tag in vars.STRFRY_IMAGE would pull
# here, unbudgeted: a known gap, not a claim.
pull-retry pull_image#*/sleep:backoff#* excluded the pull is skipped inside every lane deadline, see above
# A wall-clock loop (SECONDS < deadline) can start one more 1 s tick just
# before its bound. The confirm branch ends the script either way.
ready sleep:1#1 charge READY_TIMEOUT + 1
confirm sleep:READY_CONFIRM_SECS#1 charge READY_CONFIRM_SECS once the confirm branch exits the script, pass or fail

unit tooling/e2e/ci/setup-network-guard.sh
# `-w` waits only while another process holds the xtables lock. Every deadline
# that installs the guard runs it first, and docker, the job's only other
# iptables writer, runs in an earlier step or after it in the same shell.
xtables-lock */iptables-w:5#* excluded nothing else holds the xtables lock while the guard runs, see above
xtables-lock6 */ip6tables-w:5#* excluded nothing else holds the xtables lock while the guard runs, see above
# A wall-clock loop (SECONDS < deadline) can run one tick past its bound.
probe-wait main#1/do_install#1/await_log#*/sleep:1#1 charge PROBE_TIMEOUT + 1
probe-send main#1/do_install#1/send_probe#*/nc-w:1#1 charge 1

lib tooling/e2e/ci/app-install-lib.sh
barrier */timeout:INSTALL_BARRIER_SECS#1 charge INSTALL_BARRIER_SECS

lib tooling/e2e/ci/logscan-gate.sh
# The log-privacy gate: the key-material floor and the identifier scanner over
# files already on disk — no wait of its own, so its budget is the wrapper's,
# which is nothing.
scan */bash:scan-logs.sh#* charge @

# ---------------------------------------------------------------------------
# Single-target lanes
# ---------------------------------------------------------------------------

unit tooling/e2e/ci/run-single-avd-scenario.sh
install lib:install_fresh#1 charge @
# The post-drive log-privacy gate: the key-material floor and the identifier
# scanner over files already on disk — no wait of its own, so its budget is the
# wrapper's, which is nothing.
logscan log_privacy_gate#1/lib:logscan_gate#1 charge @
# The route wait runs first: Wi-Fi is disabled only once it finds a cellular route.
route sleep:2#1 charge GUEST_NET_TIMEOUT_SECS
wifi-off sleep:2#2 charge WIFI_OFF_TIMEOUT_SECS
# Only the last attempt can reach DRIVE_TIMEOUT: an attempt is retried after a
# pre-connect stall the watchdog ended or a connect flake, never after a hang.
drive drive_with_connect_watchdog#1/spawn_flutter_drive#1/timeout:DRIVE_TIMEOUT#1 charge DRIVE_TIMEOUT + DRIVE_KILL_AFTER_SECS once a retried attempt ends at the connect watchdog, charged below
# Each retried attempt: the watchdog's deadline, its TERM grace, the restore of
# an app the failed attempt's teardown uninstalled (a fresh, flushed install),
# and the settle. In the last attempt the watchdog runs inside the drive.
watchdog drive_with_connect_watchdog#1/sleep:WATCHDOG_POLL_SECS#1 charge CONNECT_WATCHDOG_SECS times DRIVE_MAX_ATTEMPTS - 1
watchdog-grace drive_with_connect_watchdog#1/sleep:WATCHDOG_KILL_GRACE_SECS#1 charge WATCHDOG_KILL_GRACE_SECS times DRIVE_MAX_ATTEMPTS - 1
restore lib:install_app#1 charge @ times DRIVE_MAX_ATTEMPTS - 1
settle sleep:DRIVE_RETRY_SETTLE_SECS#1 charge DRIVE_RETRY_SETTLE_SECS times DRIVE_MAX_ATTEMPTS - 1

unit tooling/e2e/ci/run-b3-real-gps.sh
strfry bash:start-strfry.sh#1 charge @
device wait-for-device#1 allowance
install lib:install_fresh#1 charge @
geo-drip sleep:GEO_REISSUE_SECS#1 concurrent
drive timeout:DRIVE_TIMEOUT#1 charge DRIVE_TIMEOUT + DRIVE_KILL_AFTER_SECS
# The log-privacy gate after the drive and over the whole evidence directory
# at exit: files already on disk, no wait of its own (logscan-gate.sh).
logscan lib:logscan_gate#1 charge @
logscan-exit cleanup#1/lib:logscan_gate_dir#1 charge @

unit tooling/e2e/ci/run-b1-fgs-publish.sh
strfry bash:start-strfry.sh#1 charge @
device wait-for-device#1 allowance
install lib:install_fresh#1 charge @
geo-drip sleep:10#1 concurrent
idle-driver sleep:2#1 concurrent
barrier-cue sleep:1#1 concurrent
barrier-wait timeout:BARRIER_TIMEOUT_SECS#1 concurrent
drive timeout:DRIVE_TIMEOUT#1 charge DRIVE_TIMEOUT + DRIVE_KILL_AFTER_SECS
# After the drive the sampler is joined only through this bounded loop, which
# kills it if it is still running at the end.
sampler-stop sleep:1#2 charge 3 * SAMPLE_PERIOD_SECS
sampler sleep:SAMPLE_PERIOD_SECS#1 within sampler-stop the sampler is joined only after sampler-stop, which kills it if still running
# The log-privacy gate after the drive and over the whole evidence directory
# at exit: files already on disk, no wait of its own (logscan-gate.sh).
logscan lib:logscan_gate#1 charge @
logscan-exit cleanup#1/lib:logscan_gate_dir#1 charge @

unit tooling/e2e/ci/run-b5-permission-revocation.sh
strfry bash:start-strfry.sh#1 charge @
device wait-for-device#1 allowance
install lib:install_fresh#1 charge @
geo-drip sleep:GEO_REISSUE_SECS#* concurrent
act1 timeout:DRIVE1_TIMEOUT#1 charge DRIVE1_TIMEOUT + DRIVE_KILL_AFTER_SECS
# ACT 1's harness side runs while its drive does. What can outlast the drive
# is the app-op tail: the denial is held APPOPS_MIN_DENY_SECS of wall clock
# from the moment it lands (overshooting by one relay poll), then restored and
# read back, then the revoke cue is polled once more.
appop-hold sleep:RELAY_POLL_SECS#1 charge APPOPS_MIN_DENY_SECS + RELAY_POLL_SECS
appop-denied wait_for_appops_mode#1/sleep:2#1 within appop-hold the hold is measured from the denial, so this read-back is inside it
appop-settle sleep:APPOPS_SETTLE#1 within appop-hold the hold is measured from the denial, so this settle is inside it
appop-window wait_for_marker_polling_relay#1/sleep:RELAY_POLL_SECS#1 within appop-hold the hold is measured from the denial, so this window is inside it
appop-restored wait_for_appops_mode#2/sleep:2#1 charge APPOPS_VERIFY_TIMEOUT
revoke-cue wait_for_marker#2/sleep:MARKER_POLL_SECS#1 poll
arm-cue wait_for_marker#1/sleep:MARKER_POLL_SECS#1 within revoke-cue after the drive exits only one cue wait polls: a dead drive skips the app-op branch and ends the revoke-cue wait at once
revoke-settle sleep:REVOKE_SETTLE#1 charge REVOKE_SETTLE
reinstall lib:install_app#1 charge @
act2 timeout:DRIVE2_TIMEOUT#1 charge DRIVE2_TIMEOUT + DRIVE_KILL_AFTER_SECS
act2-relay sleep:RELAY_POLL_SECS#2 poll
# The log-privacy gate after each act's drive and over the whole evidence
# directory at exit: files already on disk, no wait of its own
# (logscan-gate.sh).
logscan report_drive#*/lib:logscan_gate#1 charge @
logscan-exit cleanup#1/lib:logscan_gate_dir#1 charge @

unit tooling/e2e/ci/run-b6-location-provider-toggle.sh
strfry bash:start-strfry.sh#1 charge @
device wait-for-device#1 allowance
install lib:install_fresh#1 charge @
provider-on set_provider#1/sleep:1#1 charge PROVIDER_READBACK_SECS
geo-drip sleep:GEO_REISSUE_SECS#1 concurrent
drive timeout:DRIVE_TIMEOUT#1 charge DRIVE_TIMEOUT + DRIVE_KILL_AFTER_SECS
# The toggles run while the drive does; after it exits, one cue wait polls,
# the OFF toggle may still read back, and one of the two restores runs.
disable-cue wait_for_marker#1/sleep:MARKER_POLL_SECS#1 poll
provider-off set_provider#2/sleep:1#1 charge PROVIDER_READBACK_SECS
reenable-cue wait_for_marker#2/sleep:MARKER_POLL_SECS#1 within disable-cue after the drive exits only one cue wait polls: the second returns at once on a dead drive
provider-restore set_provider#3/sleep:1#1 charge PROVIDER_READBACK_SECS
provider-restore-else set_provider#4/sleep:1#1 within provider-restore the if and else restores are exclusive: exactly one runs
# The log-privacy gate after the drive and over the whole evidence directory
# at exit: files already on disk, no wait of its own (logscan-gate.sh).
logscan lib:logscan_gate#1 charge @
logscan-exit cleanup#1/lib:logscan_gate_dir#1 charge @

unit tooling/e2e/ci/run-b8-clock-skew.sh
strfry bash:start-strfry.sh#1 charge @
device wait-for-device#* allowance
install lib:install_fresh#1 charge @
# Joined by stop_servo after the drive: the loop sees SERVO_STOP within a poll.
clock-servo clock_servo#1/sleep:SERVO_POLL_SECS#1 poll
drive timeout:DRIVE_TIMEOUT#1 charge DRIVE_TIMEOUT + DRIVE_KILL_AFTER_SECS
# The log-privacy gate after the drive and over the whole evidence directory
# at exit: files already on disk, no wait of its own (logscan-gate.sh).
logscan lib:logscan_gate#1 charge @
logscan-exit cleanup#1/lib:logscan_gate_dir#1 charge @

unit tooling/e2e/ci/run-b9-network-reconnect.sh
strfry bash:start-strfry.sh#1 charge @
device wait-for-device#1 allowance
install lib:install_fresh#1 charge @
airplane-check set_airplane#1/sleep:1#1 charge AIRPLANE_READBACK_SECS
drive timeout:DRIVE_TIMEOUT#1 charge DRIVE_TIMEOUT + DRIVE_KILL_AFTER_SECS
# After the drive exits: one cue wait polls, then airplane mode is set and
# cleared in turn, each read back.
down-cue wait_for_marker#1/sleep:MARKER_POLL_SECS#1 poll
airplane-on set_airplane#2/sleep:1#1 charge AIRPLANE_READBACK_SECS
up-cue wait_for_marker#2/sleep:MARKER_POLL_SECS#1 within down-cue after the drive exits only one cue wait polls: the second returns at once on a dead drive
airplane-off set_airplane#3/sleep:1#1 charge AIRPLANE_READBACK_SECS
# The log-privacy gate after the drive and over the whole evidence directory
# at exit: files already on disk, no wait of its own (logscan-gate.sh).
logscan lib:logscan_gate#1 charge @
logscan-exit cleanup#1/lib:logscan_gate_dir#1 charge @

unit tooling/e2e/ci/run-kp-rotation.sh
strfry bash:start-strfry.sh#* charge @
device wait-for-device#* allowance
install lib:install_fresh#1 charge @
# One loop: the wait for a cellular route and the Wi-Fi read-back share this bound.
wifi-off sleep:2#1 charge WIFI_OFF_TIMEOUT_SECS
# Joined by stop_servo after the drive: the loop sees SERVO_STOP within a poll.
clock-servo clock_servo#1/sleep:SERVO_POLL_SECS#1 poll
drive timeout:DRIVE_TIMEOUT#1 charge DRIVE_TIMEOUT + DRIVE_KILL_AFTER_SECS
# The log-privacy gate after the drive and over the whole evidence directory
# at exit: files already on disk, no wait of its own (logscan-gate.sh).
logscan lib:logscan_gate#1 charge @
logscan-exit cleanup#1/lib:logscan_gate_dir#1 charge @

# ---------------------------------------------------------------------------
# Aggregate lanes: reaped by design. Budgeted in full all the same — the check
# accepts the declaration only while the sum really exceeds the deadline, the
# lane runs several drives, and one drive's bound is below the deadline.
# ---------------------------------------------------------------------------

reaper e2e-integration.yml::e2e_integration eight targets, each a full run-single-avd-scenario.sh; the deadline reaps a degraded run, the per-target drive timeout names a hung target
reaper e2e-relay-customization.yml::e2e_relay_customization four targets, each up to two run-single-avd-scenario.sh runs; the deadline reaps a degraded run, the per-target drive timeout names a hung target
reaper e2e-background-catchup.yml::e2e_background_catchup three phase drives, a guest reboot and marker waits; sized from measurement, the per-phase drive timeout names a hung phase

unit tooling/e2e/ci/run-integration-tests.sh
strfry run_one#1/bash:start-strfry.sh#1 charge @ times ARGC
target run_one#1/bash:run-single-avd-scenario.sh#1 charge @ times ARGC
logscan lib:logscan_gate_dir#1 charge @

unit tooling/e2e/ci/run-relay-customization.sh
relays run_one#1/reset_relays#1/*/bash:start-strfry.sh#1 charge @ times ARGC
# The second run is the designed retry of a target whose first ended in 124.
target run_one#1/drive_target#*/bash:run-single-avd-scenario.sh#1 charge @ times ARGC
# The OD-2 cue watcher beside each drive, joined after it: one more tick once
# the drive has touched its done file, and at most one start of R2 from the
# watcher or, when the drive ended between its cues, from the restore.
cue-poll run_one#1/drive_target#*/r2_cue_watch#1/sleep:R2_CUE_POLL_SECS#1 poll times ARGC
cue-start run_one#1/drive_target#*/r2_cue_watch#1/r2_cue_pass#*/start_r2#1/bash:start-strfry.sh#1 charge @ times ARGC once the watcher returns after its one start
cue-restore run_one#1/drive_target#*/start_r2#1/bash:start-strfry.sh#1 charge @ times ARGC
logscan lib:logscan_gate_dir#1 charge @

unit tooling/e2e/ci/run-m7-background-catchup.sh
strfry */reset_strfry#1/bash:start-strfry.sh#1 charge @
# The gate over each drive log before it is echoed, over a logcat before any
# tail of it is, and over the whole evidence directory in the EXIT trap.
logscan */lib:logscan_gate*#* charge @
install */lib:install_*#1 charge @
drive */drive_target#1/timeout:DRIVE_TIMEOUT#1 charge DRIVE_TIMEOUT + DRIVE_KILL_AFTER_SECS
# Recovery runs inside wall-clock loops (register, force-run): its time falls
# inside their window, and only their last iteration can run into one more.
recover */ensure_device_online#1/sleep:3#1 charge DEVICE_ONLINE_TIMEOUT + 3 once the enclosing loops are wall-clock windows, so only their last pass adds a recovery
cold-home */go_cold#1/sleep:3#1 charge 3
cold-kill */go_cold#1/sleep:2#1 charge 2
# Wall-clock loops (SECONDS < deadline) can run one tick past their bound.
register main#1/phase_a#1/sleep:3#1 charge JOB_REGISTER_TIMEOUT + 3
register-negative main#1/run_negative_phase#?/sleep:3#1 charge JOB_REGISTER_TIMEOUT + 3
force-run */force_run_until_marker#1/sleep:1#1 charge MARKER_TIMEOUT + FORCE_RUN_ROUND_POLL
force-run-tail */force_run_until_marker#1/wait_for_marker#1/sleep:2#1 within force-run it waits only what is left of force-run's own deadline
setup-marker main#1/phase_a#1/wait_for_marker#1/sleep:2#1 charge MARKER_TIMEOUT + 2
# Phase B's restart: the AVD-name read, the power-off, then the wait for the powered-off
# guest's emulator to exit (a wall-clock loop, one tick past its bound).
restart-avd main#1/phase_b#1/restart_guest#1/timeout:ADB_READ_SECS#1 charge ADB_READ_SECS
restart-poweroff main#1/phase_b#1/restart_guest#1/timeout:ADB_READ_SECS#2 charge ADB_READ_SECS
restart-off main#1/phase_b#1/restart_guest#1/sleep:2#1 charge SHUTDOWN_TIMEOUT + 2
# Each boot read is bounded and falls inside the boot loop's window; the last
# one can start just before the deadline and run its whole bound.
boot-read main#1/phase_b#1/wait_for_boot#1/timeout:ADB_READ_SECS#1 within boot each read runs inside the boot loop's own window, which charges the last one
boot main#1/phase_b#1/wait_for_boot#1/sleep:2#1 charge BOOT_TIMEOUT + ADB_READ_SECS + 2
rearm-marker main#1/phase_b#1/wait_for_marker#1/sleep:2#1 charge JOB_REARM_TIMEOUT + 2
negative-settle main#1/run_negative_phase#?/sleep:5#1 charge 5

# ---------------------------------------------------------------------------
# macOS lanes: `nick-fields/retry` bounds each attempt, and `flutter test`
# builds and runs the suite with no bound of its own, so there is no finite
# worst case to compare. The check verifies both facts on every run.
# ---------------------------------------------------------------------------

unbudgeted e2e-ios.yml::e2e_ios the attempt timeout is the only bound on flutter test's build and run
unbudgeted e2e-ios-auth-tier.yml::e2e_ios_auth_tier the attempt timeout is the only bound on flutter test's build and run
unbudgeted e2e-ios-background-publish.yml::e2e_ios_bg_publish the attempt timeout is the only bound on flutter test's build and run
unbudgeted e2e-ios-real-gps.yml::e2e_ios_real_gps the attempt timeout is the only bound on flutter test's build and run
unbudgeted e2e-profile.yml::e2e_profile_ios the attempt timeout is the only bound on flutter test's build and run

# ---------------------------------------------------------------------------
# The iOS launch gate. macOS has no coreutils `timeout`, so the runner bounds
# each xcodebuild run itself (run_bounded, a wall-clock poll released when the
# process exits) and a failed leg's crash-report wait the same way.
# ---------------------------------------------------------------------------

unit tooling/e2e/ci/run-launch-gate-ios.sh
# The log-privacy gate over the summary already on disk: the wrapper's budget.
logscan main#1/on_exit#1/finish#1/lib:logscan_gate#1 charge @
test */run_test#*/run_bounded#1/sleep:1#1 charge TEST_SECS + 1
kill-grace */run_test#*/run_bounded#1/sleep:1#2 charge KILL_GRACE_SECS + 1
crash-report */run_test#*/sleep:1#1 charge IPS_SETTLE_SECS + 1

# ---------------------------------------------------------------------------
# The Tier-1 soak lane. No emulator, no app: the rig is a cargo binary this
# runner launches under the lane's inner deadline.
#
# It carries ONE bound, deliberately, and this manifest is where that decision
# is visible. A second inner `timeout` around the rig would be charged here at
# its own bound, and the pr lane's arithmetic makes that impossible: the run
# budget is 1320 s of scenario work under a 1380 s deadline, which the lane arms
# as `23m` (`profiles/pr.toml`, `soak-core.yml`), and every lane also
# carries the 180 s unbounded-work allowance this check declares once for all
# of them — so an inner bound large enough to let a healthy run finish is the
# 1320 s budget, which with that allowance prices the lane at 1500 s, past its
# own 1380 s deadline, and would force it to ~25 m for no diagnostic
# gain. The rig's rc taxonomy names WHAT went wrong; the deadline only ever
# names THAT it hung. The `cargo run` itself is unbounded work that is not a
# wait (the header's last section), so it is priced by that allowance and by
# nothing else — which is exactly the honest reading: the deadline is the bound.
# ---------------------------------------------------------------------------

unit tooling/e2e/ci/run-soak-core.sh
# Both scans read files already on disk: the key-material floor and the
# identifier scanner over the evidence tree, once against the manifest the rig
# sealed from its own declarations and once against the host needles. Neither
# waits for anything, so each costs the wrapper's own budget.
#
# The path is a glob because one scan is reached three ways — the end of a
# healthy run, the EXIT trap that catches the reaper, and the `--scan-only`
# entry the lane's scan-before-upload step uses — and all three are the same
# two calls, at the same cost.
rig-scan */bash:scan-logs.sh#1 charge @
logscan */lib:logscan_gate#1 charge @

# ---------------------------------------------------------------------------
# The Android release launch gate: three legs of install, cold launches and
# screen polls on one AVD, no drive. Every wait is a bounded adb read inside a
# wall-clock loop (SECONDS < deadline), so each loop is charged its bound plus
# the one read that can start just before it, and the reads that share a loop
# with the dump are within the dump's charge.
# ---------------------------------------------------------------------------

unit tooling/e2e/ci/run-launch-gate-android.sh
device main#1/preconditions#1/timeout:BOOT_SECS#1 charge BOOT_SECS
boot main#1/preconditions#1/timeout:ADB_SECS#1 charge BOOT_SECS + ADB_SECS
offline main#1/preconditions#1/timeout:ADB_SECS#2 charge OFFLINE_SECS + ADB_SECS + ADB_SECS
offline-net main#1/preconditions#1/timeout:ADB_SECS#3 within offline both reads of one pass are in offline's charge
install */lib:install_fresh#1 charge @
upgrade-install */lib:install_app#1 charge @
launch */launch_app#*/timeout:LAUNCH_SECS#1 charge LAUNCH_SECS
launch-pid */launch_app#*/pid_now#1/timeout:ADB_SECS#1 charge PROCESS_SECS + ADB_SECS
journey */journey#1/observe#1/timeout:DUMP_SECS#1 charge JOURNEY_SECS + DUMP_SECS + ADB_SECS
journey-alive */journey#1/alive#1/pid_now#1/timeout:ADB_SECS#1 within journey each pass's pid read is in the journey's charge
reopen */expect_reopened#1/observe#1/timeout:DUMP_SECS#1 charge REOPEN_SECS + DUMP_SECS + ADB_SECS
reopen-alive */expect_reopened#1/alive#1/pid_now#1/timeout:ADB_SECS#1 within reopen each pass's pid read is in the reopen's charge
stop */stop_app#1/pid_now#1/timeout:ADB_SECS#1 charge PROCESS_SECS + ADB_SECS
# The settle watch after a candidate's terminal screen: one dump and one pid
# read per pass, within its wall-clock window.
settle-watch */settle_watch#*/observe#1/timeout:DUMP_SECS#1 charge SETTLE_SECS + DUMP_SECS + ADB_SECS
settle-alive */settle_watch#*/alive#1/pid_now#1/timeout:ADB_SECS#1 within settle-watch each pass's pid read is in the watch's charge
crash-read */crash_evidence#1/timeout:ADB_SECS#* charge ADB_SECS
device-state main#1/finish#1/timeout:ADB_SECS#1 charge ADB_SECS
# The log-privacy gate over the summaries in the EXIT trap: files already on
# disk, no wait of its own (logscan-gate.sh).
logscan main#1/finish#1/lib:logscan_gate#1 charge @
