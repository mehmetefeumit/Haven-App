# The dependency scanners, pinned. Sourced by audit.yml (and every workflow
# that installs a scanner), so a scan's verdict changes only when the advisory
# data does, never because a scanner released underneath it.
#
# cargo-audit floated until 0.23.0 (2026-11-10) reached CI two days after its
# release with a breaking change (the advisory-db lock file renamed, #1744),
# taken by no commit. A scanner is code that runs over every lockfile with the
# job's token in reach; it gets the same cooldown dependabot.yml gives every
# other dependency.
#
# Bumping: change one value, run audit.yml's scans locally with it (each
# script's header names its command), and re-cut any fixture that records the
# tool's output in the same commit.

# 0.22.2 (2026-06-05): past the 14-day minor cooldown that 0.23.0 is not, and
# its `--json` report has the shape check_audit_ignores_live.sh's fixtures were
# cut from (0.22.1), re-verified field for field on 2026-11-12.
CARGO_AUDIT_VERSION=0.22.2

# Installed with `go install github.com/google/osv-scanner/v2/cmd/osv-scanner@…`:
# the module and its whole build graph are checked against the Go checksum
# database, where a release asset is a mutable upload. v2.7.1 is the first
# release with `effectiveUntil` on `[[IgnoredVulns]]`, the expiry the ledger
# (osv-scanner.toml) rests on; it is younger than the cooldown, which is the
# price of that field. Its go.mod asks for Go 1.27.3, the `go-version` every
# workflow that builds it sets (audit.yml, security-nightly.yml): move them
# with this pin.
OSV_SCANNER_VERSION=v2.7.1

# The workflow linter, installed from this one wheel with
# `pip install --no-deps --require-hashes --only-binary :all:`: zizmor ships as
# a self-contained binary inside it, so the hash is the whole install. 1.31.1
# (2026-10-15) is the newest release past the 14-day cooldown (1.32.0 is
# 2026-11-02).
ZIZMOR_VERSION=1.31.1
ZIZMOR_WHEEL_SHA256=58e878eb2dbd2c6183c105e1ac28c14f7dd1eca44a783f1fe2a69647d012c410
