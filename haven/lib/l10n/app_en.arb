  "onboardingValueProp1Title": "Only your circles can see you",
  "@onboardingValueProp1Title": {
    "description": "Headline of the first onboarding value-prop card (also reused on the About page)."
  },
  "onboardingValueProp1Body": "Your location is encrypted on your device before it leaves, so only the circles you choose can read it, never Haven or anyone else. Because Haven is open source, anyone can verify that.",
  "@onboardingValueProp1Body": {
    "description": "Body of the first onboarding value-prop card (also reused on the About page)."
  },
  "onboardingValueProp2Title": "No one can shut it down",
  "@onboardingValueProp2Title": {
    "description": "Headline of the second onboarding value-prop card (also reused on the About page)."
  },
  "onboardingValueProp2Body": "Haven has no central server. Your encrypted messages travel through independent servers called relays, and you choose which ones to use. No single company or government can switch the network off.",
  "@onboardingValueProp2Body": {
    "description": "Body of the second onboarding value-prop card (also reused on the About page)."
  },
  "onboardingValueProp3Title": "No account needed",
  "@onboardingValueProp3Title": {
    "description": "Headline of the third onboarding value-prop card (also reused on the About page)."
  },
  "onboardingValueProp3Body": "No email, no phone number, no sign-up. Haven creates an identity whose secret key never leaves your phone, so there is no account for anyone to hand over.",
  "@onboardingValueProp3Body": {
    "description": "Body of the third onboarding value-prop card (also reused on the About page)."
  },
  "onboardingValueProp1Summary": "Encrypted on your device, so only the circles you choose can read it.",
  "@onboardingValueProp1Summary": {
    "description": "Short one-line summary of the first value prop, shown under its title on the onboarding intro screen. The longer onboardingValueProp1Body is shown on the About page instead. Keep it to roughly one short sentence so the intro screen fits without scrolling."
  },
  "onboardingValueProp2Summary": "No central server . It runs on a relay network you choose.",
  "@onboardingValueProp2Summary": {
    "description": "Short one-line summary of the second value prop, shown under its title on the onboarding intro screen. Keep it to roughly one short sentence so the intro screen fits without scrolling."
  },
  "onboardingValueProp3Summary": "No email, phone, or sign-up. Your secret key never leaves your phone.",
  "@onboardingValueProp3Summary": {
    "description": "Short one-line summary of the third value prop, shown under its title on the onboarding intro screen. Keep it to roughly one short sentence so the intro screen fits without scrolling. Must stay consistent with onboardingValueProp3Body, which it summarises: an earlier version claimed 'nothing links it to you', which over-claimed (the user's network address is visible to every relay, and the same key carries a renameable public profile). Keep the claim narrowed to key custody."
