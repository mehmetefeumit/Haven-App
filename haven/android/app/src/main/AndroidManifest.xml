<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Network access for Nostr relay connections (WSS). Declared
         explicitly rather than relying on transitive plugin manifest-merge,
         so a release build can never ship without it (a missing INTERNET
         permission would silently break all relay sync). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Default-network callbacks (NetworkChangeStream.kt): the engine
         re-dials its relays when the device changes network. A normal
         permission, granted at install. Declared explicitly for the same
         reason INTERNET is. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location permissions for accessing device location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Background location (Android 10+ / API 29+) -->
    <uses-permission
        android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        android:minSdkVersion="29" />

    <!-- Foreground service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_LOCATION"
        android:minSdkVersion="29" />
    <!-- Notification permission (Android 13+ / API 33) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Battery optimization exemption request -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Wake lock for the scoped `Haven:publish` PARTIAL_WAKE_LOCK the
         foreground service holds across one publish cycle
         (PublishWakeLock.kt). Declared explicitly rather than relying on the
         transitive merge from flutter_foreground_task's manifest, so removing
         or replacing that plugin cannot silently take the permission — and the
         lock — away with it. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Receive-boot-completed permission required by the RebootReceiver so the
         FGS can be restarted after a device reboot when background sharing is
         enabled. LIVE since M7-E: the receiver below is enabled="true" and
         autoRunOnBoot:true is set in ForegroundTaskOptions inside
         BackgroundLocationManager.init(). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Camera, for the QR scanner only (QrScanner.kt), asked for when the
         scanner opens. Not required: a device without a camera still installs
         Haven and adds people by pasting their key. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The CAMERA permission implies a required rear camera with autofocus
         unless these say otherwise. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- android:name is a custom Application (extends android.app.Application,
         which is what Flutter's ${applicationName} placeholder resolves to)
         whose onCreate registers the Android context with the Rust ndk_context
         crate for EVERY process start. Without this, a cold WorkManager
         background-catch-up wake (no MainActivity) panics "android context was
         not initialized" the first time the Rust keyring is touched. See
         HavenApplication.kt. -->
    <application
        android:label="Haven"
        android:name=".HavenApplication"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Required by flutter_foreground_task. Do not change the service name. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />
        <!-- image_cropper (uCrop) crop/rotate editor for the profile photo.
             uCrop requires an AppCompat theme; DayNight follows the system
             light/dark mode (the toolbar/control colors are themed at runtime
             via AndroidUiSettings). Operates on the already-picked file, so it
             needs no photo permission. -->
        <!-- Locked to portrait: a mid-crop configuration change recreates the
             activity and discards the in-progress crop, so we avoid the rotation
             churn for a quick one-shot square crop (Haven itself is portrait). -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />
        <!-- AppCompat's emoji2 registers EmojiCompatInitializer with
             androidx.startup, which at every cold start asks the system font
             provider (Google Play services, where present) for the emoji
             font: a cross-app request naming Haven, and start-up work, for
             emoji Flutter draws itself. Removed by the documented opt-out;
             AppCompat widgets (uCrop's among them) then skip EmojiCompat.
             Excluding the emoji2 module instead would crash
             AppCompatTextView. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
        <!-- RebootReceiver: ENABLED at M7-E (backgroundCatchupEnabled == true,
             paired with autoRunOnBoot:true in ForegroundTaskOptions.init())
             so the FGS restarts after a device reboot when background sharing
             was enabled. Guard check 14c pins this state; the reboot re-arm
             is runtime-proven by the e2e-background-catchup lane (Phase B).
             History (M7-C fix, constraint 2b): tools:node="replace" was
             removed from THIS receiver ONLY — that attribute was stripping
             the plugin's BOOT_COMPLETED <intent-filter> from the merged
             manifest, causing the receiver to never fire. Do not re-add it
             here. -->
        <receiver
            android:name="com.pravera.flutter_foreground_task.service.RebootReceiver"
            android:enabled="true" />
        <!-- RestartReceiver: keep tools:node="replace" to suppress the
             plugin's auto-restart-on-ANR/kill behaviour — Haven manages the
             FGS lifecycle explicitly. This receiver must remain disabled. -->
        <receiver
            android:name="com.pravera.flutter_foreground_task.service.RestartReceiver"
            android:enabled="false"
            tools:node="replace" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Google Play monitoring-app declaration. Haven is consensual
             circle/family location sharing (not parental control or
             enterprise), so the value is "other". The matching "monitoring
             app" + Data safety declarations are console-side: they live in the
             Play Console, not in this repository, so nothing here can assert
             they are current. What the app actually does in the background —
             the behaviour those declarations must match — is stated in
             docs/privacy/README.md and in haven-core/SECURITY.md, "Scheduled
             background wakes (M7)". (This comment used to cite
             docs/MAP_AND_PRIVACY_BACKLOG.md, which does not exist in this
             tree.) -->
        <meta-data
            android:name="isMonitoringTool"
            android:value="other" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required for url_launcher to resolve https/mailto links on
             Android 11+ (package visibility): OSM attribution, Stadia legal
             pages, "report a map issue" / "support OpenStreetMap". -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>
