<?xml version="1.0" encoding="utf-8"?>
<!-- Text Android shows with no Flutter engine running (BootResume.kt,
     ResumeNotice.kt). Each entry mirrors the ARB key its name spells in
     camelCase (fgs_notification_sharing = fgsNotificationSharing), and each
     values-<lang>/strings.xml mirrors that locale's ARB;
     test/l10n/android_notice_strings_test.dart holds every entry equal to its
     ARB value. Edit the ARB first, then copy the text here. -->
<resources>
    <string name="fgs_notification_sharing">O Haven está enviando e recebendo informações de localização</string>
    <string name="android_resume_notice_title">O compartilhamento de localização parou</string>
    <string name="android_resume_notice_body">Toque para abrir o Haven e voltar a compartilhar sua localização com seus círculos.</string>
    <string name="android_resume_notice_channel_name">Lembretes de compartilhamento</string>
</resources>
