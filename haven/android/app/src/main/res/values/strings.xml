<?xml version="1.0" encoding="utf-8"?>
<!-- Text Android shows with no Flutter engine running (BootResume.kt,
     ResumeNotice.kt). Each entry mirrors the ARB key its name spells in
     camelCase (fgs_notification_sharing = fgsNotificationSharing), and each
     values-<lang>/strings.xml mirrors that locale's ARB;
     test/l10n/android_notice_strings_test.dart holds every entry equal to its
     ARB value. Edit the ARB first, then copy the text here. -->
<resources>
    <string name="fgs_notification_sharing">Haven is sending and receiving location information</string>
    <string name="android_resume_notice_title">Location sharing has stopped</string>
    <string name="android_resume_notice_body">Tap to open Haven and resume sharing your location with your circles.</string>
    <string name="android_resume_notice_channel_name">Sharing reminders</string>
</resources>
