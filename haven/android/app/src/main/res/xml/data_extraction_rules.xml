<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of Haven's leaves the device by backup or device-to-device transfer.

  android:allowBackup="false" stops both on Android 11 and lower. On
  Android 12+ it stops cloud backup, but some manufacturers' devices still
  run device-to-device transfers for an app that targets API 31+; those
  follow only these rules, and a section left out allows everything. So
  both sections exclude every domain. A cross-platform transfer (Android 16
  QPR2+) needs its own opt-in section, and there is none.

  Held by scripts/ci/check_android_no_backup.sh.
  See: https://developer.android.com/about/versions/12/behavior-changes-12#backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
