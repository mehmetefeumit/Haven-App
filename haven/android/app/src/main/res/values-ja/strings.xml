<?xml version="1.0" encoding="utf-8"?>
<!-- Text Android shows with no Flutter engine running (BootResume.kt,
     ResumeNotice.kt). Each entry mirrors the ARB key its name spells in
     camelCase (fgs_notification_sharing = fgsNotificationSharing), and each
     values-<lang>/strings.xml mirrors that locale's ARB;
     test/l10n/android_notice_strings_test.dart holds every entry equal to its
     ARB value. Edit the ARB first, then copy the text here. -->
<resources>
    <string name="fgs_notification_sharing">Haven が位置情報を送受信しています</string>
    <string name="android_resume_notice_title">位置情報の共有が停止しました</string>
    <string name="android_resume_notice_body">タップして Haven を開き、サークルとの位置情報の共有を再開してください。</string>
    <string name="android_resume_notice_channel_name">共有のリマインダー</string>
</resources>
