#!/usr/bin/env bash
#
# Pre-push gate. Two checks, in cheapest-first order:
#
#   1. The privacy-invariant manifest, run against THE COMMIT BEING PUSHED
#      (~11 s).
#   2. The coverage gate — a SUPERSET of .github/workflows/coverage.yml: every
#      gate that workflow can fail on, failing here first (both suites with
#      coverage, both aggregates, the per-path floors, the undeclared-skip
#      check and the rollback-path flag-off run). The two stacks run in
#      parallel, so the cost is the slower of them (~6-11 min) rather than
#      their sum.
#
# The instant half (manifest lint + guard self-tests) also runs on pre-commit,
# so by the time you push it has already passed several times.
#
# ## Why (1) needs a WORKTREE and cannot just run the guard here
#
# Both hooks otherwise read the WORKING TREE, and the working tree is not what
# gets pushed. The manifest gate is a CITATION resolver: it fails when an
# invariant names a symbol, test, guard or document section that does not
# exist. Split the pair across a commit — stage the manifest, leave the
# document it cites unstaged — and every working-tree check passes while the
# pushed commit is broken. That is exactly CI run 32622119290: commit 7f6d33f
# carried a `KP-SLOT-WIDTH` citation into
# `MARMOT_PROTOCOL_KNOWLEDGE.md#the-d-slot-id-is-shape-normative` while the
# heading of that name existed only in an uncommitted edit, and the guard was
# green locally and red in CI for the same tree.
#
# `git worktree add --detach` materialises the pushed commit read-only in a
# temp directory. Unlike `git stash` it cannot lose work, and unlike a bare
# `git archive` extraction it is still a git repository — which the guard
# requires (it treats a non-git directory as a misconfiguration, not a pass).
# Checkout is ~0.1 s.
#
# Enable once per clone:  scripts/ci/install_git_hooks.sh
# Bypass a single push:   git push --no-verify
#
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
readonly ZERO='0000000000000000000000000000000000000000'

# git feeds `<local ref> <local sha> <remote ref> <remote sha>` per ref. A
# deletion has an all-zero local sha and nothing to check.
locals=()
remotes=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ -n "${local_sha:-}" && "${local_sha}" != "${ZERO}" ]] || continue
  locals+=("${local_sha}")
  remotes+=("${remote_sha:-${ZERO}}")
done
# Invoked by hand (no stdin), or a push git described in some shape this loop
# did not recognise: fall back to HEAD rather than silently checking nothing.
if (( ${#locals[@]} == 0 )); then
  locals=("$(git -C "${ROOT}" rev-parse HEAD)")
  remotes=("${ZERO}")
fi

echo "▶ Pre-push manifest gate on the commit(s) being pushed (~11 s each)."
for i in "${!locals[@]}"; do
  sha="${locals[${i}]}"
  base="${remotes[${i}]}"
  wt="$(mktemp -d)"
  git -C "${ROOT}" worktree add --detach -q "${wt}" "${sha}"
  # Ratchet against the remote tip when we actually have that commit; a first
  # push, a new branch or a fetch we are behind on leaves nothing to compare
  # against, and CI ratchets regardless.
  args=(--no-ratchet)
  if [[ "${base}" != "${ZERO}" ]] \
     && git -C "${ROOT}" rev-parse --verify --quiet "${base}^{commit}" >/dev/null; then
    args=(--baseline-ref "${base}")
  fi
  rc=0
  bash "${wt}/scripts/ci/check_privacy_invariants.sh" "${args[@]}" || rc=$?
  git -C "${ROOT}" worktree remove --force "${wt}" 2>/dev/null || true
  rm -rf "${wt}"
  if (( rc != 0 )); then
    echo "✗ ${sha:0:8} does not satisfy the privacy-invariant manifest." >&2
    echo "  This ran against the COMMIT, not your working tree — a citation" >&2
    echo "  whose target you have edited but not committed fails exactly here." >&2
    exit "${rc}"
  fi
done

echo "▶ Pre-push coverage gate (superset of CI's Coverage job; ~6-11 min). Bypass with: git push --no-verify"
exec "$ROOT/scripts/ci/check_coverage.sh"
