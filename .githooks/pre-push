#!/usr/bin/env bash
#
# Pre-push coverage gate.
#
# A SUPERSET of .github/workflows/coverage.yml — every gate that workflow can
# fail on, failing here first: both suites with coverage, both aggregates, the
# per-path floors, the undeclared-skip check and the rollback-path flag-off run.
# The two stacks run in parallel, so the cost is the slower of them (~6-11 min)
# rather than their sum.
#
# The instant half (manifest lint + guard self-tests) also runs on pre-commit,
# so by the time you push it has already passed several times.
#
# Enable once per clone:  scripts/ci/install_git_hooks.sh
# Bypass a single push:   git push --no-verify
#
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
echo "▶ Pre-push coverage gate (superset of CI's Coverage job; ~6-11 min). Bypass with: git push --no-verify"
exec "$ROOT/scripts/ci/check_coverage.sh"
