#!/usr/bin/env bash
#
# Pre-commit: the checks that need no toolchain and no test run.
#
# Two of them, both derived rather than duplicated, both a few seconds:
#
#   1. the coverage-manifest lint (below), and
#   2. the fast SOURCE guards from repo-guards.yml, in parallel
#      (scripts/ci/run_source_guards.sh — see its header for why the slow e2e
#      harness self-tests are deliberately left to CI and pre-push).
#
# Under a second, every commit. It exists because the most common way the
# Coverage workflow goes red is not a coverage regression at all — it is an
# edit to scripts/ci/coverage_floors.txt that does not obey the file's own pin
# rule. Run 30964250098 died on a floor hand-set to 51 against a measured
# 51.06%: a verdict that took an 11-minute llvm-cov run to reach, on a defect
# that is visible in the diff.
#
# The full gate (which runs both suites, ~6-11 min) stays on pre-push.
#
# Enable once per clone:  scripts/ci/install_git_hooks.sh
# Bypass a single commit: git commit --no-verify
#
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# Coverage manifest lint first: it is the faster of the two, so the commonest
# failure reports soonest.
"$ROOT/scripts/ci/check_coverage.sh" --static-only

# The source guards catch a different class entirely — invariants about the
# SHAPE of the code (an access gate that stopped preceding a read, a publish
# chain that lost its bound, a secret that became loggable). CI run 31216078806
# went red on exactly one of those, and it was a two-second grep away.
exec "$ROOT/scripts/ci/run_source_guards.sh"
